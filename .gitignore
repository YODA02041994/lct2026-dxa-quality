data/raw/*
!data/raw/.gitkeep
data/work/
docs/materials/*
!docs/materials/.gitkeep
docs/TZ_full.txt
# производные от медицинских изображений и запись сессии организатора
docs/img/
docs/transcripts/

# --- артефакты
__pycache__/
*.pyc
.venv/
.pytest_cache/
runs/
weights/*.pt
weights/*.pth
*.egg-info/
.DS_Store
