# --- материалы организатора: выданы под пароль, в git НЕ хранятся (репозиторий к сдаче публичный)
# скачивание: LCT_PASSWORD=... scripts/download_data.sh
data/raw/*
!data/raw/.gitkeep
data/work/
docs/materials/*
!docs/materials/.gitkeep
docs/TZ_full.txt
# производные от медицинских изображений и запись сессии организатора
docs/img/
docs/transcripts/

# --- артефакты
__pycache__/
*.pyc
.venv/
.pytest_cache/
runs/
weights/*.pt
weights/*.pth
*.egg-info/
.DS_Store
.idea/
.vscode/

# --- презентация: личные данные участников и файл на шаблоне организатора — вне git (PPTX лежит в Release)
presentation/team.json
presentation/*.pptx
presentation/*.pdf
presentation/_trimmed.pptx
# картинки презентации со снимками организатора — вне git (собираются scripts/export_examples.py и gradcam_examples.py)
presentation/img/cases.jpg
presentation/img/gradcam.jpg
presentation/img/ov_*.png
presentation/img/ui.png

# FleXray: локальная копия флагманской модели (387 МБ, CC-BY-NC-4.0) — кладётся download_weights.sh
weights/flexray/

# снимки постановщика для слайдов и снимки стенда — только в презентации (Release/стенд), не в git (AGENTS.md, правило 1)
presentation/img/cases_src/
presentation/img/cases2*.jpg
presentation/img/ui_levels*.jpg
presentation/img/ui_*.jpg
